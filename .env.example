# Copy to .env and fill in real values. Both are required at startup —
# pydantic-settings raises a validation error immediately if either is
# missing, rather than booting with a silent default.

DATABASE_URL=postgres://user:password@host:5432/dbname
# Must match Django's SIMPLE_JWT_SIGNING_KEY exactly (decision 13) — this
# is a shared secret between the two services, not two independent keys.
JWT_SIGNING_KEY=
# spec 0005 — participant/judge LLM calls (user's choice: OpenAI for this milestone).
OPENAI_API_KEY=
# spec 0047 — the cofounder agent's Google Places lookup tool. A real
# Google Cloud API key with the Places API (New) enabled and billing set up.
GOOGLE_API_KEY=
# spec 0048 — the cofounder agent's Pinecone RAG tool. A real Pinecone
# API key. PINECONE_INDEX_NAME isn't required here — it has a safe code
# default ("cofounder-training"), only set it to override.
PINECONE_API_KEY=
# Temporal server address — e.g. temporal:7233 inside docker-compose.
TEMPORAL_ADDRESS=temporal:7233
# Redis, for live debate streaming (spec 0013) — e.g. redis:6379/0 inside docker-compose.
REDIS_URL=

# Only needed to run docker-compose.yml here — substituted into the
# DATABASE_URL override, must match the platform-infra repo's own .env
# (dialex-net's db service) since both point at the same Postgres.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
